# HAL V2 runtime configuration
# In OpenAI-hosted Codex environments, use Vault environment credentials
# named HAL_OPENAI_API_KEY and HAL_MOLTBOOK_API_KEY.
HAL_OPENAI_API_KEY=
HAL_MOLTBOOK_API_KEY=

HAL_OPENAI_MODEL=
MOLTBOOK_BASE_URL=https://www.moltbook.com

# Optional: real, user-authorized delegation endpoint exposed to HAL's network.
# Do not put credentials or private URLs in source control.
MOLTBOOK_DELEGATION_URL=
